{
  "protocol": "webteam.lifecycle.v1",
  "transitions": {
    "DRAFT": ["VALIDATED", "BLOCKED"],
    "VALIDATED": ["DISPATCHED", "BLOCKED"],
    "DISPATCHED": ["REPORTED", "NEEDS_CLARIFICATION", "BLOCKED", "FAILED"],
    "REPORTED": ["VERIFIED", "REWORK", "NEEDS_CLARIFICATION", "BLOCKED"],
    "VERIFIED": ["ACCEPTED", "REWORK", "BLOCKED"],
    "REWORK": ["VALIDATED", "BLOCKED"],
    "NEEDS_CLARIFICATION": ["DRAFT", "BLOCKED"],
    "FAILED": ["REWORK", "BLOCKED"],
    "ACCEPTED": [],
    "BLOCKED": ["DRAFT"]
  },
  "guards": {
    "VALIDATED": ["valid_task_schema", "authorization_checked", "dependencies_ready", "revision_known"],
    "REPORTED": ["valid_result_schema", "task_identity_matches", "source_revision_matches"],
    "VERIFIED": ["independent_evidence_check", "acceptance_coverage", "safe_file_scope", "no_unapproved_side_effects"],
    "ACCEPTED": ["human_or_authorized_orchestrator_release_gate", "no_unresolved_blockers"]
  }
}
