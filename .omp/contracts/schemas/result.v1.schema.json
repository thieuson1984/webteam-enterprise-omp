{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "protocol": {
      "const": "webteam.result.v1"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9-]{2,79}$"
    },
    "agent": {
      "enum": [
        "webteam-orchestrator",
        "webteam-product",
        "webteam-designer",
        "webteam-architect",
        "webteam-frontend",
        "webteam-backend",
        "webteam-database",
        "webteam-security",
        "webteam-qa",
        "webteam-devops",
        "webteam-performance",
        "webteam-accessibility",
        "webteam-reviewer",
        "webteam-researcher",
        "webteam-documentation",
        "webteam-integration"
      ]
    },
    "input_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "reported_revision": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "SUBMITTED_FOR_VERIFY",
        "NEEDS_CLARIFICATION",
        "BLOCKED",
        "FAILED"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "acceptance": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "state": {
            "enum": [
              "NOT_STARTED",
              "IMPLEMENTED_UNVERIFIED",
              "BLOCKED",
              "NOT_APPLICABLE"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0,
            "maxItems": 100,
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "state",
          "evidence_refs"
        ]
      },
      "minItems": 1,
      "maxItems": 100
    },
    "changed_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0,
      "maxItems": 100,
      "uniqueItems": true
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "NOT_RUN",
              "BLOCKED"
            ]
          },
          "command": {
            "type": [
              "string",
              "null"
            ]
          },
          "evidence_ref": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "name",
          "status",
          "command",
          "evidence_ref"
        ]
      },
      "maxItems": 100
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0,
      "maxItems": 100,
      "uniqueItems": true
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0,
      "maxItems": 100,
      "uniqueItems": true
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0,
      "maxItems": 100,
      "uniqueItems": true
    },
    "next_owner": {
      "type": [
        "string",
        "null"
      ]
    },
    "approval_requested": {
      "type": "boolean"
    }
  },
  "required": [
    "protocol",
    "task_id",
    "agent",
    "input_sha256",
    "reported_revision",
    "status",
    "summary",
    "acceptance",
    "changed_paths",
    "tests",
    "evidence_refs",
    "blockers",
    "risks",
    "next_owner",
    "approval_requested"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://webteam.example.invalid/schemas/result.v1.schema.json",
  "title": "WebTeam Agent Result v1"
}
