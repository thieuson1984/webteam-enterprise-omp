{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "protocol": {
      "const": "webteam.verification.v1"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9-]{2,79}$"
    },
    "verifier": {
      "enum": [
        "webteam-orchestrator",
        "webteam-product",
        "webteam-designer",
        "webteam-architect",
        "webteam-frontend",
        "webteam-backend",
        "webteam-database",
        "webteam-security",
        "webteam-qa",
        "webteam-devops",
        "webteam-performance",
        "webteam-accessibility",
        "webteam-reviewer",
        "webteam-researcher",
        "webteam-documentation",
        "webteam-integration"
      ]
    },
    "input_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "result_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "observed_revision": {
      "type": "string",
      "minLength": 1
    },
    "decision": {
      "enum": [
        "VERIFIED",
        "REWORK",
        "CLARIFY",
        "BLOCKED"
      ]
    },
    "checked_acceptance_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0,
      "maxItems": 100,
      "uniqueItems": true
    },
    "confirmed_evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0,
      "maxItems": 100,
      "uniqueItems": true
    },
    "failed_checks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0,
      "maxItems": 100,
      "uniqueItems": true
    },
    "notes": {
      "type": "string",
      "minLength": 1
    },
    "independent": {
      "type": "boolean"
    }
  },
  "required": [
    "protocol",
    "task_id",
    "verifier",
    "input_sha256",
    "result_sha256",
    "observed_revision",
    "decision",
    "checked_acceptance_ids",
    "confirmed_evidence_refs",
    "failed_checks",
    "notes",
    "independent"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://webteam.example.invalid/schemas/verification.v1.schema.json",
  "title": "WebTeam Verification v1"
}
