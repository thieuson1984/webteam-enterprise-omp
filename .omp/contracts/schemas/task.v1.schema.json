{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "protocol": {
      "const": "webteam.task.v1"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9-]{2,79}$"
    },
    "parent_task_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "assigned_agent": {
      "enum": [
        "webteam-orchestrator",
        "webteam-product",
        "webteam-designer",
        "webteam-architect",
        "webteam-frontend",
        "webteam-backend",
        "webteam-database",
        "webteam-security",
        "webteam-qa",
        "webteam-devops",
        "webteam-performance",
        "webteam-accessibility",
        "webteam-reviewer",
        "webteam-researcher",
        "webteam-documentation",
        "webteam-integration"
      ]
    },
    "objective": {
      "type": "string",
      "minLength": 12,
      "maxLength": 1500
    },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "request_ref": {
          "type": "string",
          "minLength": 1
        },
        "approved_goal": {
          "type": "string",
          "minLength": 1
        },
        "confirmed_constraints": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "maxItems": 100,
          "uniqueItems": true
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "maxItems": 100,
          "uniqueItems": true
        },
        "acceptance_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true
        }
      },
      "required": [
        "request_ref",
        "approved_goal",
        "confirmed_constraints",
        "assumptions",
        "acceptance_ids"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repo_revision": {
          "type": "string",
          "minLength": 1
        },
        "repository_scope": {
          "type": "string",
          "minLength": 1
        },
        "docs_revision": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "repo_revision",
        "repository_scope",
        "docs_revision"
      ]
    },
    "context_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+"
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "path",
          "purpose"
        ]
      },
      "maxItems": 30
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allowed_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "maxItems": 100,
          "uniqueItems": true
        },
        "excluded_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "maxItems": 100,
          "uniqueItems": true
        },
        "out_of_scope": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "maxItems": 100,
          "uniqueItems": true
        },
        "change_policy": {
          "enum": [
            "READ_ONLY",
            "LOCAL_EDIT",
            "APPROVAL_REQUIRED"
          ]
        },
        "external_side_effects": {
          "const": false
        }
      },
      "required": [
        "allowed_paths",
        "excluded_paths",
        "out_of_scope",
        "change_policy",
        "external_side_effects"
      ]
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0,
      "maxItems": 100,
      "uniqueItems": true
    },
    "deliverables": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required_checks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true
        },
        "required_evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "maxItems": 100,
          "uniqueItems": true
        },
        "independent_review": {
          "type": "boolean"
        }
      },
      "required": [
        "required_checks",
        "required_evidence",
        "independent_review"
      ]
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "risk_tier": {
          "enum": [
            "LIGHT",
            "STANDARD",
            "CRITICAL"
          ]
        },
        "max_retries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "on_ambiguity": {
          "enum": [
            "REQUEST_CLARIFICATION",
            "BLOCK"
          ]
        },
        "budget_note": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "risk_tier",
        "max_retries",
        "on_ambiguity",
        "budget_note"
      ]
    }
  },
  "required": [
    "protocol",
    "task_id",
    "parent_task_id",
    "assigned_agent",
    "objective",
    "origin",
    "source",
    "context_refs",
    "scope",
    "dependencies",
    "deliverables",
    "verification",
    "execution"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://webteam.example.invalid/schemas/task.v1.schema.json",
  "title": "WebTeam Task Contract v1"
}
