{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "protocol": {
      "const": "webteam.review.v1"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9-]{2,79}$"
    },
    "reviewer": {
      "const": "webteam-reviewer"
    },
    "source_revision": {
      "type": "string",
      "minLength": 1
    },
    "verdict": {
      "enum": [
        "NO_BLOCKERS_FOUND",
        "CHANGES_REQUESTED",
        "INCONCLUSIVE"
      ]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9-]{2,79}$"
          },
          "severity": {
            "enum": [
              "CRITICAL",
              "HIGH",
              "MEDIUM",
              "LOW"
            ]
          },
          "confidence": {
            "enum": [
              "CONFIRMED",
              "LIKELY",
              "HYPOTHESIS"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+"
          },
          "line": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "scenario": {
            "type": "string",
            "minLength": 1
          },
          "impact": {
            "type": "string",
            "minLength": 1
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0,
            "maxItems": 100,
            "uniqueItems": true
          },
          "suggested_check": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "severity",
          "confidence",
          "path",
          "line",
          "scenario",
          "impact",
          "evidence_refs",
          "suggested_check"
        ]
      },
      "maxItems": 100
    },
    "coverage_notes": {
      "type": "string",
      "minLength": 1
    },
    "missing_evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0,
      "maxItems": 100,
      "uniqueItems": true
    }
  },
  "required": [
    "protocol",
    "task_id",
    "reviewer",
    "source_revision",
    "verdict",
    "findings",
    "coverage_notes",
    "missing_evidence"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://webteam.example.invalid/schemas/review.v1.schema.json",
  "title": "WebTeam Independent Review v1"
}
